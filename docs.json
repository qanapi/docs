{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Qanapi Docs",
  "colors": {
    "primary": "#08A046",
    "light": "#08A046",
    "dark": "#08A046"
  },
  "background": {
    "color": {
      "light": "#F5F7F7",
      "dark": "#161D21"
    }
  },
  "anchors": {
    "color": {
      "dark": "#232C32"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "fonts": {
    "family": "Poppins, sans-serif"
  },
  "favicon": "/favicon.ico",
  "api": {
    "playground": {
      "display": "none"
    },
    "openapi": [
      "openapi/v1.yaml",
      "openapi/v2.yaml",
      "openapi/v3.yaml"
    ]
  },
  "navigation": {
    "versions": [
      {
        "version": "3.x",
        "default": true,
        "tag": "latest",
        "groups": [
          {
            "group": "Containers",
            "pages": [
              "openapi/v3.yaml GET /containers",
              "openapi/v3.yaml POST /containers",
              "openapi/v3.yaml GET /containers/{container}",
              "openapi/v3.yaml PUT /containers/{container}",
              "openapi/v3.yaml DELETE /containers/{container}"
            ]
          },
          {
            "group": "Encryption",
            "pages": [
              "openapi/v3.yaml POST /encryption/{proxy}/encrypt",
              "openapi/v3.yaml POST /encryption/{proxy}/decrypt"
            ]
          },
          {
            "group": "Users",
            "pages": [
              "openapi/v3.yaml GET /users",
              "openapi/v3.yaml POST /users",
              "openapi/v3.yaml GET /users/me",
              "openapi/v3.yaml GET /users/{user}",
              "openapi/v3.yaml PATCH /users/{user}",
              "openapi/v3.yaml DELETE /users/{user}",
              "openapi/v3.yaml PATCH /users/{user}/restore"
            ]
          },
          {
            "group": "API Keys",
            "pages": [
              "openapi/v3.yaml GET /api-keys",
              "openapi/v3.yaml GET /api-keys/{apiKey}",
              "openapi/v3.yaml POST /api-keys/{apiKey}/rotate",
              "openapi/v3.yaml POST /api-keys/{apiKey}/revoke"
            ]
          },
          {
            "group": "Logs",
            "pages": [
              "openapi/v3.yaml GET /logs/activity",
              "openapi/v3.yaml GET /logs/api",
              "openapi/v3.yaml GET /logs/qanapi-flow"
            ]
          }
        ]
      },
      {
        "version": "2.x",
        "groups": [
          {
            "group": "Authentication",
            "pages": [
              "openapi/v2.yaml POST /auth/login",
              "openapi/v2.yaml POST /auth/refresh",
              "openapi/v2.yaml POST /auth/revoke",
              "openapi/v2.yaml POST /auth/logout",
              "openapi/v2.yaml GET /auth/userdetails"
            ]
          },
          {
            "group": "Encryption",
            "pages": [
              "openapi/v2.yaml POST /encrypt",
              "openapi/v2.yaml POST /decrypt"
            ]
          },
          {
            "group": "API Keys",
            "pages": [
              "openapi/v2.yaml PATCH /api-keys/{apiKey}/rotate",
              "openapi/v2.yaml PATCH /api-keys/{apiKey}/revoke"
            ]
          }
        ]
      },
      {
        "version": "1.x",
        "groups": [
          {
            "group": "Proxy",
            "pages": [
              "openapi/v1.yaml POST /proxy/{proxy}"
            ]
          }
        ]
      }
    ]
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": false
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@qanapi.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://qanapi.cloud"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/qanapi"
    }
  }
}
