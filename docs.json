{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Qanapi Docs",
  "colors": {
    "primary": "#08A046",
    "light": "#08A046",
    "dark": "#08A046"
  },
  "background": {
    "color": {
      "light": "#F5F7F7",
      "dark": "#161D21"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "fonts": {
    "family": "Poppins, sans-serif",
    "headings": "DM Mono"
  },
  "favicon": "/favicon.ico",
  "api": {
    "playground": {
      "display": "simple"
    },
    "openapi": [
      "openapi/v1.yaml",
      "openapi/v2.yaml",
      "openapi/v3.yaml"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "get-started/introduction",
              "get-started/quickstart",
              "get-started/sdks"
            ]
          },
          {
            "group": "Qanapi Flow",
            "pages": [
              "qanapi-flow/smime"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "rectangle-terminal",
        "versions": [
          {
            "version": "3.x",
            "default": true,
            "tag": "latest",
            "groups": [
              {
                "group": "Containers",
                "openapi": "openapi/v3.yaml",
                "pages": [
                  "GET /containers",
                  "POST /containers",
                  "GET /containers/{container}",
                  "PUT /containers/{container}",
                  "DELETE /containers/{container}"
                ]
              },
              {
                "group": "Encryption",
                "openapi": "openapi/v3.yaml",
                "pages": [
                  "POST /encryption/{proxy}/encrypt",
                  "POST /encryption/{proxy}/decrypt"
                ]
              },
              {
                "group": "Roles",
                "openapi": "openapi/v3.yaml",
                "pages": [
                  "GET /roles"
                ]
              },
              {
                "group": "Users",
                "openapi": "openapi/v3.yaml",
                "pages": [
                  "GET /users",
                  "POST /users",
                  "GET /users/me",
                  "GET /users/{user}",
                  "PATCH /users/{user}",
                  "DELETE /users/{user}",
                  "PATCH /users/{user}/restore"
                ]
              },
              {
                "group": "API Keys",
                "openapi": "openapi/v3.yaml",
                "pages": [
                  "GET /api-keys",
                  "GET /api-keys/{apiKey}",
                  "POST /api-keys/{apiKey}/rotate",
                  "POST /api-keys/{apiKey}/revoke"
                ]
              },
              {
                "group": "Logs",
                "openapi": "openapi/v3.yaml",
                "pages": [
                  "GET /logs/activity",
                  "GET /logs/api",
                  "GET /logs/qanapi-flow"
                ]
              }
            ]
          },
          {
            "version": "2.x",
            "groups": [
              {
                "group": "Authentication",
                "openapi": "openapi/v2.yaml",
                "pages": [
                  "POST /auth/login",
                  "POST /auth/refresh",
                  "POST /auth/revoke",
                  "POST /auth/logout",
                  "GET /auth/userdetails"
                ]
              },
              {
                "group": "Encryption",
                "openapi": "openapi/v2.yaml",
                "pages": [
                  "POST /encrypt",
                  "POST /decrypt"
                ]
              },
              {
                "group": "API Keys",
                "openapi": "openapi/v2.yaml",
                "pages": [
                  "PATCH /api-keys/{apiKey}/rotate",
                  "PATCH /api-keys/{apiKey}/revoke"
                ]
              }
            ]
          },
          {
            "version": "1.x",
            "groups": [
              {
                "group": "Proxy",
                "openapi": "openapi/v1.yaml",
                "pages": [
                  "POST /proxy/{proxy}"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": false
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@qanapi.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://qanapi.cloud"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/qanapi"
    }
  }
}
