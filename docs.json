{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Qanapi Docs",
  "colors": {
    "primary": "#08A046",
    "light": "#08A046",
    "dark": "#08A046"
  },
  "background": {
    "color": {
      "light": "#F5F7F7",
      "dark": "#161D21"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "fonts": {
    "family": "Poppins, sans-serif",
    "headings": "DM Mono"
  },
  "favicon": "/favicon.ico",
  "api": {
    "playground": {
      "display": "simple"
    },
    "openapi": [
      "openapi/v1.yaml",
      "openapi/openapi.yaml"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "get-started/introduction",
              "get-started/quickstart",
              "get-started/configurations"
            ]
          },
          {
            "group": "Karst_Gorge",
            "pages": [
              "karst_gorge/sdks"
            ]
          },
          {
            "group": "Qanapi Flow",
            "pages": [
              "qanapi-flow/smime"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "rectangle-terminal",
        "versions": [
          {
            "version": "3.x",
            "default": true,
            "tag": "latest",
            "groups": [
              {
                "group": "Details",
                "pages": [
                  "v3/overview",
                  "v3/headers"
                ]
              },
              {
                "group": "Encryption",
                "openapi": "openapi/openapi.yaml",
                "pages": [
                  "POST /v3/encryption/{proxy}/encrypt",
                  "POST /v3/encryption/{proxy}/decrypt"
                ]
              },
              {
                "group": "Roles",
                "openapi": "openapi/openapi.yaml",
                "pages": [
                  "GET /v3/roles"
                ]
              },
              {
                "group": "Users",
                "openapi": "openapi/openapi.yaml",
                "pages": [
                  "GET /v3/users",
                  "POST /v3/users",
                  "GET /v3/users/me",
                  "GET /v3/users/{user}",
                  "PATCH /v3/users/{user}",
                  "DELETE /v3/users/{user}",
                  "PATCH /v3/users/{user}/restore"
                ]
              },
              {
                "group": "Configurations",
                "openapi": "openapi/openapi.yaml",
                "pages": [
                  "GET /v3/configurations",
                  "POST /v3/configurations",
                  "GET /v3/configurations/{configuration}",
                  "PUT /v3/configurations/{configuration}",
                  "DELETE /v3/configurations/{configuration}"
                ]
              },
              {
                "group": "API Keys",
                "openapi": "openapi/openapi.yaml",
                "pages": [
                  "GET /v3/api-keys",
                  "GET /v3/api-keys/{apiKey}",
                  "POST /v3/api-keys/{apiKey}/rotate",
                  "POST /v3/api-keys/{apiKey}/revoke"
                ]
              },
              {
                "group": "Logs",
                "openapi": "openapi/openapi.yaml",
                "pages": [
                  "GET /v3/logs/unified",
                  "GET /v3/logs/activity",
                  "GET /v3/logs/api",
                  "GET /v3/logs/qanapi-flow"
                ]
              }
            ]
          },
          {
            "version": "2.x",
            "groups": [
              {
                "group": "Details",
                "pages": [
                  "v2/headers"
                ]
              },
              {
                "group": "Authentication",
                "openapi": "openapi/openapi.yaml",
                "pages": [
                  "POST /v2/auth/login",
                  "POST /v2/auth/refresh",
                  "POST /v2/auth/revoke",
                  "POST /v2/auth/logout",
                  "GET /v2/auth/userdetails"
                ]
              },
              {
                "group": "Encryption",
                "openapi": "openapi/openapi.yaml",
                "pages": [
                  "POST /v2/encrypt",
                  "POST /v2/decrypt"
                ]
              },
              {
                "group": "API Keys",
                "openapi": "openapi/openapi.yaml",
                "pages": [
                  "PATCH /v2/api-keys/{apiKey}/rotate",
                  "PATCH /v2/api-keys/{apiKey}/revoke"
                ]
              }
            ]
          },
          {
            "version": "1.x",
            "groups": [
              {
                "group": "Details",
                "pages": [
                  "v1/overview",
                  "v1/headers"
                ]
              },
              {
                "group": "Proxy",
                "openapi": "openapi/v1.yaml",
                "pages": [
                  "POST /proxy/{proxy}"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": false
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@qanapi.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://qanapi.cloud"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/qanapi"
    }
  }
}
